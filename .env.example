# Copy to .env and adjust. Loaded by utils/config.py (pydantic-settings) and
# by the .vscode/launch.json debug configs via "envFile".

# --- Inference Engine (modules/inference_engine, used by api/main.py) ---
# NOTE: as of this writing, modules/inference_engine/engine.py has no 4-bit
# quantization path - see BACKLOG.md. A 14B model here will likely need
# ~28GB VRAM unquantized. common/llm_integration.py (used by experiments/
# scripts directly) does support 4-bit and is the working path today.
INFERENCE_ENGINE_URL=http://localhost:8001
MODEL_NAME=Qwen/Qwen3-14B
USE_VLLM=false
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.9

# --- Apache Jena Fuseki ---
# Must match the dataset name in config/fuseki/assembler.ttl (currently
# provisions a dataset literally named "dataset" - not "conceptnet" or
# "counterbench", which are what several experiment script CLI defaults
# point to - see BACKLOG.md).
FUSEKI_ENDPOINT=http://localhost:3030/dataset/query
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/dataset/update
FUSEKI_ADMIN_PASSWORD=changeme

# --- Verification ---
VERIFICATION_THRESHOLD=0.8
MAX_REFINEMENT_ITERATIONS=3

LOG_LEVEL=INFO
